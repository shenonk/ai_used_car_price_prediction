# AutoValueLK environment template
# Copy this file to .env or .env.docker and replace placeholders with real values.
# Do not commit real secrets.

# Frontend shared configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_BASE_URL=http://localhost:8000

# User frontend configuration
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Backend Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_backend_key
SUPABASE_DB_PASSWORD=your_supabase_db_password

# Stripe backend configuration
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_SUCCESS_URL=http://localhost:3000/marketplace?payment=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/marketplace?payment=cancelled
FRONTEND_URL=http://localhost:3000

# Gemini chatbot and description generation
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

# Admin login and local fallback store
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_STORE_PERSIST=true

# Runtime
NODE_ENV=development
